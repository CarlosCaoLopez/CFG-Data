# Dockerfile.inference — Motor de Cálculo D (R + Plumber)
# Uses rocker/tidyverse (dplyr, httr, jsonlite pre-installed) + Posit Package Manager
# for pre-compiled Linux binaries — avoids source compilation on every build.

FROM rocker/tidyverse:4.4

# System dependencies required by RPostgres and fitdistrplus
RUN apt-get update && apt-get install -y \
    libpq-dev \
    libsodium-dev \
    && rm -rf /var/lib/apt/lists/*

# Install remaining packages.
# On x86_64: Posit Package Manager serves pre-compiled binaries (fast).
# On ARM64 (e.g. Raspberry Pi): falls back to CRAN source compilation automatically.
RUN R -e " \
  arch <- Sys.info()[['machine']]; \
  repo <- if (arch == 'x86_64') \
    'https://packagemanager.posit.co/cran/__linux__/noble/latest' \
  else \
    'https://cloud.r-project.org'; \
  options(repos = c(REPO = repo)); \
  install.packages(c('plumber', 'RPostgres', 'fitdistrplus', 'MASS'), Ncpus = 4) \
"

WORKDIR /app

COPY inference/ ./inference/

EXPOSE 8000

CMD ["Rscript", "-e", "plumber::plumb('/app/inference/market_inference.r')$run(host='0.0.0.0', port=8000)"]
