# Dockerfile.inference — Motor de Cálculo D (R + Plumber)
# Based on rocker/r-ver for reproducible R version pinning.
# NOTE: first build is slow (~5 min) due to package compilation.

FROM rocker/r-ver:4.4

# System dependencies required by RPostgres and fitdistrplus
RUN apt-get update && apt-get install -y \
    libpq-dev \
    libssl-dev \
    libcurl4-openssl-dev \
    libsodium-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Install R packages (cached layer — only rebuilds if this line changes)
RUN R -e " \
  install.packages( \
    c('plumber', 'RPostgres', 'dplyr', 'fitdistrplus', 'MASS', 'httr', 'jsonlite'), \
    repos  = 'https://cloud.r-project.org', \
    Ncpus  = 4 \
  ) \
"

WORKDIR /app

COPY inference/ ./inference/

EXPOSE 8000

CMD ["Rscript", "-e", "plumber::plumb('/app/inference/market_inference.r')$run(host='0.0.0.0', port=8000)"]
