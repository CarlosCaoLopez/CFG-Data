# Dockerfile.inference — Motor de Cálculo D (R + Plumber)
# Uses rocker/tidyverse (dplyr, httr, jsonlite pre-installed) + Posit Package Manager
# for pre-compiled Linux binaries — avoids source compilation on every build.

FROM r-base:4.4.0

# System dependencies required by RPostgres, plumber, and fitdistrplus
RUN apt-get update && apt-get install -y \
    libpq-dev \
    libsodium-dev \
    libssl-dev \
    libcurl4-openssl-dev \
    libxml2-dev \
    && rm -rf /var/lib/apt/lists/*

RUN R -e " \
  options(repos = c(CRAN = 'https://cloud.r-project.org')); \
  install.packages(c('tidyverse', 'plumber', 'RPostgres', 'fitdistrplus', 'MASS'), Ncpus = 4) \
"

WORKDIR /app

COPY inference/ ./inference/

EXPOSE 8000

CMD ["Rscript", "-e", "plumber::plumb('/app/inference/market_inference.r')$run(host='0.0.0.0', port=8000)"]
