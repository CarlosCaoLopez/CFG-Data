# APIs Externas
ETHERSCAN_API_KEY=your_key_here

# Clave interna entre Motor R (inference) y REST API
API_KEY=your_api_key_here

# Redis
REDIS_URL=redis://localhost:6379/0

# PostgreSQL (base URL without driver prefix — connection.py derives asyncpg/psycopg2 variants)
# Local dev: localhost:5433 (docker-compose exposes postgres on 5433)
# Docker:    postgres:5432  (overridden in docker-compose.yml environment)
DATABASE_URL=postgresql://username:password@localhost:5433/dbname

# Parámetros del modelo
THETA_1=1.0
THETA_2=10.0
THETA_3=5.0
THETA_4=1.0
ELO_K_FACTOR=32

# Umbrales de alerta
ALERT_PERCENTILE_P95=0.95
ALERT_PERCENTILE_P99=0.99

# Rate limits
POLYMARKET_REQUESTS_PER_MINUTE=100
POLYGONSCAN_REQUESTS_PER_SECOND=3  # Etherscan V2 free tier limit

# Workers
NUM_WORKERS=4

# Categorías de interés
CATEGORIAS_DE_INTERES=

# Clave de login
DASHBOARD_PASSWORD=

# Monitor de caída con bot de Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


